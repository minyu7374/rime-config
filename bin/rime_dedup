#!/bin/bash

# Rime 词库去重脚本
# 用法: ./rime_dedup input_file [output_file]

set -e

if [ $# -lt 1 ]; then
    echo "用法: $0 input_file [output_file]"
    echo "示例: $0 sougou.dict.yaml sougou_dedup.dict.yaml"
    exit 1
fi

INPUT_FILE="$1"
OUTPUT_FILE="${2:-${INPUT_FILE%.yaml}_dedup.yaml}"

if [ ! -f "$INPUT_FILE" ]; then
    echo "错误: 输入文件不存在: $INPUT_FILE"
    exit 1
fi

echo "正在处理: $INPUT_FILE"
echo "输出到: $OUTPUT_FILE"

# 创建临时工作目录
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

# 分离文件头和词条内容
HEADER_END_LINE=$(grep -n "^\.\.\." "$INPUT_FILE" | head -1 | cut -d: -f1)

if [ -n "$HEADER_END_LINE" ]; then
    # 提取文件头（包括"..."行）
    head -n "$HEADER_END_LINE" "$INPUT_FILE" > "$TMP_DIR/header.txt"
    # 提取词条部分
    tail -n +$((HEADER_END_LINE + 1)) "$INPUT_FILE" > "$TMP_DIR/entries.txt"
else
    # 如果没有找到"..."行，尝试查找第一个词条行
    FIRST_ENTRY_LINE=$(grep -n -m1 -E "^[^#]" "$INPUT_FILE" | head -1 | cut -d: -f1)
    if [ -n "$FIRST_ENTRY_LINE" ]; then
        head -n $((FIRST_ENTRY_LINE - 1)) "$INPUT_FILE" > "$TMP_DIR/header.txt"
        tail -n +$FIRST_ENTRY_LINE "$INPUT_FILE" > "$TMP_DIR/entries.txt"
    else
        # 如果找不到词条行，整个文件作为词条处理
        echo "# 文件头（自动生成）" > "$TMP_DIR/header.txt"
        echo "---" >> "$TMP_DIR/header.txt"
        echo "name: $(basename "${INPUT_FILE%.*}")" >> "$TMP_DIR/header.txt"
        echo "version: \"$(date +%Y%m%d)\"" >> "$TMP_DIR/header.txt"
        echo "sort: by_weight" >> "$TMP_DIR/header.txt"
        echo "..." >> "$TMP_DIR/header.txt"
        cp "$INPUT_FILE" "$TMP_DIR/entries.txt"
    fi
fi

# 去重处理
echo "正在去重..."
awk -F'\t' '
{
    # 提取词条和拼音作为键
    key = $1 "\t" $2
    
    if (!seen[key]) {
        seen[key] = 1
        print $0
    } 
    # # 可选：打印重复信息到标准错误
    # else {
        # print "重复项已移除: " key > "/dev/stderr"
    # }
}
' "$TMP_DIR/entries.txt" > "$TMP_DIR/entries_dedup.txt"

# 合并文件头和去重后的词条
cat "$TMP_DIR/header.txt" "$TMP_DIR/entries_dedup.txt" > "$OUTPUT_FILE"

# 统计信息
ORIGINAL_COUNT=$(wc -l < "$TMP_DIR/entries.txt")
DEDUP_COUNT=$(wc -l < "$TMP_DIR/entries_dedup.txt")
REMOVED_COUNT=$((ORIGINAL_COUNT - DEDUP_COUNT))

echo "去重完成!"
echo "原始词条数: $ORIGINAL_COUNT"
echo "去重后词条数: $DEDUP_COUNT"
echo "移除重复项: $REMOVED_COUNT"
