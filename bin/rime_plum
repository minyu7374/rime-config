#!/bin/bash
#set -x

case "$(uname -s)" in
Linux*)
    export rime_frontend=fcitx5-rime
    rime_dir="$HOME/.local/share/fcitx5/rime"
    ;;
Darwin*)
    rime_dir="$HOME/Library/Rime"
    ;;
CYGWIN* | MINGW* | MSYS*)
    rime_dir="$HOME/windows/AppData/Roaming/Rime/"
    ;;
esac

plum_dir="/opt/src/tool/plum"
plum="${plum_dir}/rime-install"

if [ "$#" -eq 0 ]; then
    $plum prelude
    $plum essay # 预设词库
    $plum luna-pinyin
    $plum terra-pinyin
    $plum double-pinyin
    $plum BlindingDark/rime-easy-en
    $plum emoji
    $plum lotem/rime-octagram-data lotem/rime-octagram-data@hans # lotem/rime-octagram-data@hant
    $plum mirtlecn/rime-radical-pinyin@master # 部件拆字
    $plum mirtlecn/rime-radical-pinyin@master:config:schema=double_pinyin mirtlecn/rime-radical-pinyin@master:config:schema=flypy

    for schema in luna_pinyin terra_pinyin double_pinyin double_pinyin_flypy; do
        $plum BlindingDark/rime-easy-en:customize:schema=$schema
        $plum BlindingDark/rime-lua-select-character:customize:schema=$schema
        $plum emoji:customize:schema=$schema
        $plum lotem/rime-octagram-data:customize:schema=$schema,model=hans
        sed -i 's/__include: easy_en:/__include: easy_en_fix:/g' $schema.custom.yaml
    done

    # 部件拆字
    mkdir -p "$rime_dir"/{lua,build}
    cp {$plum_dir/package/mirtlecn/radical-pinyin,"$rime_dir"}/lua/search.lua
    cp $plum_dir/package/mirtlecn/radical-pinyin/build/*.bin "$rime_dir"/build/

    # chinese_english
    rime_wanxiang_refs=https://raw.githubusercontent.com/amzxyz/rime_wanxiang/refs/heads/wanxiang/
    # wget -nv -P "$rime_dir"/opencc/ "$rime_wanxiang_refs"/opencc/{chinese_english.json,chinese_english.txt,english_chinese.txt}
    for file in chinese_english.json chinese_english.txt english_chinese.txt; do
        wget -nv -O "$rime_dir"/opencc/$file "$rime_wanxiang_refs"/opencc/$file
    done

    # dict
    mkdir -p "$rime_dir"/dicts/
    $plum felixonmars/fcitx5-pinyin-zhwiki
    mv "$rime_dir"/zhwiki.dict.yaml "$rime_dir"/dicts/
    cd /opt/src/tool/RIME-LMDG && git pull &&
        cp -f dicts/* "$rime_dir"/dicts
    sudo emerge --update app-dicts/fcitx-pinyin-sougou-baidu 2>/dev/null
    for name in sougou baidu; do
        [ -f "/usr/share/rime-data/$name.dict.yaml" ] &&
            rime_dedup /usr/share/rime-data/$name.dict.yaml "$rime_dir"/dicts/$name.dict.yaml
    done

else
    $plum "$@"
fi
